{
  "name": "whatsapp-data-sdk",
  "version": "1.3.0",
  "description": "TypeScript SDK for the WhatsApp Data API (checkleaked.cc / RapidAPI): profile info, phone breaches, carrier lookup, Telegram, OSINT, bulk checks and a money-saving cache-first lookup.",
  "keywords": [
    "whatsapp",
    "osint",
    "phone",
    "lookup",
    "carrier",
    "breach",
    "leak",
    "telegram",
    "rapidapi",
    "checkleaked",
    "sdk",
    "typescript"
  ],
  "author": "Eduardo Airaudo <airaudoeduardo@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/eduair94/whatsapp-data-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduair94/whatsapp-data-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/eduair94/whatsapp-data-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env LIVE=1 vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
